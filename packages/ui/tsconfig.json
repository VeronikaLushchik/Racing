{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2020"],
		"module": "ESNext",
		"moduleResolution": "node",
		"jsx": "react-jsx",
		"noEmit": true,
		"baseUrl": ".",
		"types": ["vite/client"],
		"paths": {
			"~@ui/*": ["src/ui/*"],
			"~@components/*": ["src/components/*"],
			"~@engines/*": ["src/engines/*"],
			"src/*": ["src/*"],
			"@racing/shared": ["../shared/src/index.ts"]
		}
	},
	"include": ["src"]
}
