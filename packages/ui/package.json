{
	"name": "@racing/ui",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.json --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"translations:keys": "node scripts/generateTranslationKeys.cjs",
		"test:unit": "tsc -p tsconfig.test.json && node --test scripts/*.test.cjs"
	},
	"dependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-query": "^3.39.3",
		"react-router-dom": "^5.3.4"
	},
	"devDependencies": {
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"@types/react-router-dom": "^5.3.3",
		"@vitejs/plugin-react": "^4.3.1",
		"sass": "^1.77.8",
		"vite": "^5.4.2"
	}
}
